{
  "name": "github-pr-to-slack",
  "version": "1.3.0",
  "description": "Send GitHub PR information to Slack with a single click",
  "private": true,
  "scripts": {
    "build": "NODE_ENV=production webpack --config webpack.config.js",
    "build:dev": "NODE_ENV=development webpack --config webpack.config.js",
    "watch": "NODE_ENV=development webpack --watch --config webpack.config.js",
    "dev": "npm run build:dev && npm run watch",
    "eslint-fix": "eslint --fix ./src",
    "prettier": "prettier --write .",
    "create-icons": "node scripts/create-disabled-icons.js",
    "package": "npm run build && node scripts/package-extension.js",
    "test": "vitest run",
    "test:fast": "vitest run --typecheck=false",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ci": "vitest run --coverage --typecheck=false --reporter=verbose",
    "test:ui": "vitest --ui"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/plugin-transform-react-jsx": "^7.23.4",
    "@babel/preset-env": "^7.23.9",
    "@babel/preset-react": "^7.26.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.0.308",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "@vitest/coverage-v8": "^3.0.8",
    "@vitest/ui": "^3.0.8",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "^11.0.0",
    "css-loader": "^6.8.1",
    "eslint": "^8.45.0",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "happy-dom": "^17.4.1",
    "jsdom": "^26.0.0",
    "mini-css-extract-plugin": "^2.7.6",
    "msw": "^2.2.3",
    "prettier": "^2.8.8",
    "sharp": "^0.33.5",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.2",
    "typescript": "5.1.6",
    "vitest": "^3.0.8",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "@hookform/resolvers": "^4.1.3",
    "classnames": "^2.5.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "react-router-dom": "^6.30.0",
    "zod": "^3.24.2"
  }
}
